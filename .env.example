# ============================================================
# VLB LINE Bot 環境變數設定範本
# 複製此檔案為 .env 並填入實際數值
# 注意：.env 檔案不可上傳到 GitHub
# ============================================================

# LINE Bot 設定（從 LINE Developers Console 取得）
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 主管的 LINE User ID（傳送工作日誌後系統會取得，或從 Webhook 日誌中查找）
ADMIN_LINE_USER_ID=U1234567890abcdef

# Anthropic Claude API 金鑰（從 console.anthropic.com 取得）
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx

# 電子郵件通知設定（使用 Gmail App Password，非帳號密碼）
NOTIFY_EMAIL=manager@example.com
GMAIL_USER=your_gmail_account@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Google Sheets 設定
# GOOGLE_SHEETS_ID：試算表網址中 /d/ 後面那段
GOOGLE_SHEETS_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# GOOGLE_SERVICE_ACCOUNT_JSON：服務帳號金鑰 JSON 全文（單行）
# 注意：私鑰中的換行符號需替換為 \n
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n","client_email":"bot@your-project.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# 伺服器連接埠（Render.com 會自動設定，本地開發用）
PORT=3000
